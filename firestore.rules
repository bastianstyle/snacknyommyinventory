rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    // Fungsi untuk memeriksa apakah pengguna sudah login.
    function isAuthenticated() {
      return request.auth != null;
    }

    // Fungsi untuk mendapatkan data pengguna dari koleksi 'users'.
    function getUserData() {
      // Baca dokumen pengguna yang sedang login. Aturan di bawah harus mengizinkan ini.
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Fungsi untuk memeriksa apakah pengguna memiliki peran tertentu.
    function hasRole(role) {
      // Pastikan pengguna diautentikasi dan dokumen pengguna ada sebelum mencoba mengakses 'role'
      return isAuthenticated() && getUserData() != null && getUserData().role == role;
    }

    // Fungsi untuk memeriksa apakah pengguna adalah Admin.
    function isAdmin() {
      return hasRole('admin');
    }

    // Fungsi untuk memeriksa apakah pengguna adalah Manajer.
    function isManager() {
      return hasRole('manager');
    }
    
    // Fungsi untuk memeriksa apakah manajer ditugaskan ke cabang tertentu.
    function isManagerOfBranch(branchId) {
      return isManager() && getUserData().branchId == branchId;
    }

    // --- Collection Rules ---

    // Aturan untuk Koleksi Pengguna (Users)
    match /users/{userId} {
      // Izinkan pengguna yang diautentikasi untuk membaca dokumen pengguna mereka sendiri.
      // Ini penting agar getUserData() dapat berfungsi.
      allow get: if request.auth.uid == userId;
      
      // Izinkan admin untuk membaca (list) semua dokumen pengguna.
      allow list: if isAdmin();
      
      // Izinkan admin untuk membuat/mengubah/menghapus dokumen pengguna apa pun.
      // Pengguna tidak dapat membuat pengguna baru sendiri melalui klien.
      allow create, update, delete: if isAdmin();
    }

    // 1. Aturan untuk Manajemen Cabang (Branches)
    // Hanya admin yang bisa membuat, mengubah, atau menghapus cabang.
    // Semua pengguna yang login bisa melihat daftar cabang.
    match /branches/{branchId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // 2. Aturan untuk Manajemen Item Master (Items)
    // Hanya admin yang bisa membuat, mengubah, atau menghapus item master.
    // Semua pengguna yang login bisa melihat daftar item.
    match /items/{itemId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // 3. Aturan untuk Manajemen Inventaris (Inventory)
    // Semua pengguna terautentikasi bisa melihat stok di semua cabang
    // untuk keperluan transfer antar cabang.
    // Admin adalah pengawas, bukan pelaksana: create/update stok harian
    // hanya boleh dilakukan oleh Manajer cabang yang bersangkutan.
    match /inventory/{inventoryId} {
      allow read: if isAuthenticated();
      allow create, update: if isManagerOfBranch(request.resource.data.branchId);
      allow delete: if isAdmin();
    }

    // 4. Aturan untuk Transfer Inventaris (Transfers)
    // Manajer bisa MEMBUAT permintaan transfer UNTUK cabang mereka (toBranchId).
    // Admin TIDAK bisa membuat transfer dan TIDAK bisa approve/reject/ship/receive -
    // Admin murni pengawas (read-only): hanya melihat status & info kurir/pengiriman.
    // Manajer cabang asal yang approve/reject/ship, manajer cabang tujuan yang receive.
    // Saat receive (status -> completed), wajib sertakan proofPhotoUrl (foto bukti,
    // disimpan sebagai data URI base64 karena tidak memakai Firebase Storage) dan
    // dibatasi ukurannya agar tidak melebihi limit dokumen Firestore (1MB).
    match /transfers/{transferId} {
      allow read: if isAdmin() || (isManager() && (isManagerOfBranch(resource.data.fromBranchId) || isManagerOfBranch(resource.data.toBranchId)));
      allow create: if isManagerOfBranch(request.resource.data.toBranchId);
      allow update: if
        (isManagerOfBranch(resource.data.fromBranchId) && request.resource.data.status in ['approved', 'rejected', 'shipped']) ||
        (isManagerOfBranch(resource.data.toBranchId) && request.resource.data.status == 'completed'
          && request.resource.data.proofPhotoUrl is string
          && request.resource.data.proofPhotoUrl.size() > 0
          && request.resource.data.proofPhotoUrl.size() < 900000
          && request.resource.data.receivedBy == request.auth.uid);
      allow delete: if isAdmin();
    }

    // 5. Aturan untuk Transaksi Barang Masuk (Incoming Items)
    // Catatan transaksi harian, hanya Manajer cabang terkait yang boleh mencatat.
    // Admin hanya bisa membaca (pengawasan/laporan), tidak input transaksi.
    match /incoming_items/{incomingItemId} {
      allow read: if isAdmin() || isManagerOfBranch(resource.data.branchId);
      allow create: if isManagerOfBranch(request.resource.data.branchId);
      allow update, delete: if isAdmin();
    }

    // 6. Aturan untuk Transaksi Barang Keluar (Outgoing Items)
    // Sama seperti Barang Masuk: hanya Manajer cabang terkait yang boleh mencatat.
    match /outgoing_items/{outgoingItemId} {
      allow read: if isAdmin() || isManagerOfBranch(resource.data.branchId);
      allow create: if isManagerOfBranch(request.resource.data.branchId);
      allow update, delete: if isAdmin();
    }
  }
}